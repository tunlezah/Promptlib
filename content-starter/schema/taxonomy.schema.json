{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/prompt-library/schema/taxonomy.schema.json",
  "title": "Prompt Library taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["models", "assistants", "categories", "roles"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string" },
          "vendor": { "type": "string" },
          "icon": { "type": "string", "description": "Icon id from the site's built-in icon set, or a short text glyph." },
          "description": { "type": "string" }
        }
      }
    },
    "assistants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string" },
          "vendor": { "type": "string" },
          "icon": { "type": "string" },
          "description": { "type": "string" },
          "docs_url": { "type": "string", "format": "uri" },
          "open_url_template": {
            "type": "string",
            "description": "URL that opens the host with a prefilled prompt. {prompt} is replaced with the URL-encoded prompt."
          },
          "open_url_max_length": { "type": "integer", "minimum": 200 },
          "install": {
            "type": "object",
            "description": "Destination path per artefact type. {id} is replaced with the artefact id. Values ending in / are folders.",
            "additionalProperties": false,
            "properties": {
              "skill": { "type": "string" },
              "rule": { "type": "string" },
              "agent": { "type": "string" },
              "command": { "type": "string" },
              "hook": { "type": "string" },
              "mcp": { "type": "string" },
              "plugin": { "type": "string" },
              "workflow": { "type": "string" },
              "prompt": { "type": "string" },
              "system-prompt": { "type": "string" }
            }
          },
          "install_note": { "type": "string", "description": "One sentence shown under the install paths (for example how to reload)." }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
