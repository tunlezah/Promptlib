{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/prompt-library/schema/collection.schema.json",
  "title": "Prompt Library collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "items"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "audience": { "type": "string", "maxLength": 200 },
    "start_here": { "type": "boolean", "description": "Exactly one collection may set this; it is shown to first-time visitors." },
    "order": { "type": "integer" },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    }
  }
}
